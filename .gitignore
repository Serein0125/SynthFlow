# 依赖与构建产物
node_modules/
dist/
build/
out/
coverage/
*.tsbuildinfo

# 本工作区专用的缓存(pnpm store / npm cache,见 .npmrc)
.pnpm-store/
.cache/

# 日志与本地环境变量
*.log
npm-debug.log*
pnpm-debug.log*
.env
.env.*
!.env.example

# npm 本机设置：里面会有本机绝对缓存路径和你自己选的 registry，
# 每个开发者都不一样，属于机器私有配置，不入库。
.npmrc

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 临时文件
*.tmp
COMMIT_MSG*

# SynthFlow 本机运行数据（模型配置、快照、会话、记忆、索引、测试产物）
# 这些都可以随时删除，且不应进版本库 —— 里面有你填的 API Key，
# 以及被当成本项目的那些代码的快照（可能是别人的私有仓库）。
.synthflow/

# SynthFlow 生成出来的代码：留一个空目录占位，内容不入库
workspace/*
!workspace/.gitkeep

